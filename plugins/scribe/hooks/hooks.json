{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.client_path}",
            "args": [
              "--hook",
              "SessionStart"
            ],
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.client_path}",
            "args": [
              "--hook",
              "UserPromptSubmit"
            ],
            "timeout": 1
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(AskUserQuestion|ExitPlanMode)$",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.client_path}",
            "args": [
              "--hook",
              "PreToolUse"
            ],
            "timeout": 130
          }
        ]
      },
      {
        "matcher": "^(?!(AskUserQuestion|ExitPlanMode)$).*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.client_path}",
            "args": [
              "--hook",
              "PreToolUse"
            ],
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.client_path}",
            "args": [
              "--hook",
              "PostToolUse"
            ],
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.client_path}",
            "args": [
              "--hook",
              "PostToolUseFailure"
            ],
            "timeout": 1
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.client_path}",
            "args": [
              "--hook",
              "PermissionRequest"
            ],
            "timeout": 130
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.client_path}",
            "args": [
              "--hook",
              "Notification"
            ],
            "timeout": 1
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.client_path}",
            "args": [
              "--hook",
              "SubagentStart"
            ],
            "timeout": 1
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.client_path}",
            "args": [
              "--hook",
              "SubagentStop"
            ],
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.client_path}",
            "args": [
              "--hook",
              "Stop"
            ],
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.client_path}",
            "args": [
              "--hook",
              "SessionEnd"
            ],
            "timeout": 1
          }
        ]
      }
    ]
  }
}
