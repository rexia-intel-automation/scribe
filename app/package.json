{
  "name": "scribe-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "tsc -p ui/tsconfig.json && vite build --config ui/vite.config.ts",
    "test": "vitest run --config ui/vite.config.ts",
    "lint": "eslint ui/src ui/test",
    "format:check": "prettier --check ui/src ui/test ui/*.ts ui/*.json package.json",
    "tauri": "tauri",
    "e2e": "playwright test --config ui/playwright.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "^24.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "30.1.2",
    "axe-core": "4.14.0",
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.9"
  }
}
