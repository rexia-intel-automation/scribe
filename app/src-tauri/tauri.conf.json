{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scribe",
  "version": "0.1.0",
  "identifier": "com.rexia.scribe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist",
    "features": ["desktop"]
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{"label":"main","title":"Scribe","create":false,"width":372,"height":700,"visible":false,"decorations":false,"alwaysOnTop":true,"resizable":false,"transparent":true,"shadow":false}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"}
  },
  "bundle": {"active":false,"icon":["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"]}
}
